// Espelho de schema.prisma usado só no deploy serverless (Netlify), apontando para o
// Postgres gerenciado (Netlify Database) em vez do arquivo SQLite local. Existem dois
// arquivos porque o Prisma não permite trocar o provider do datasource em tempo de
// execução — local/testes continuam 100% em SQLite (schema.prisma), sem exigir rede.
// Qualquer mudança de modelo aqui também precisa ser replicada em schema.prisma (e vice-versa).
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-pg"
}

datasource db {
  provider = "postgresql"
}

enum Plano {
  SOLO
  EQUIPE
}

enum PapelUsuario {
  DONO
  PROFISSIONAL
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  ATENDIDO
  FALTOU
  CANCELADO
}

enum OrigemAgendamento {
  LINK
  MANUAL
}

enum TipoMensagem {
  CONFIRMACAO
  LEMBRETE
  CONVITE_RETORNO
}

enum CanalMensagem {
  SMS
  WHATSAPP
  EMAIL
}

enum StatusMensagem {
  PENDENTE
  ENVIADA
  ERRO
  CANCELADA
}

model Estabelecimento {
  id                 String   @id @default(cuid())
  nome               String
  slug               String   @unique
  telefone           String
  endereco           String
  fuso               String   @default("America/Recife")
  corDestaque        String   @default("#0EA5A0")
  foto               String?
  logoFundo          String   @default("#FFFFFF")
  plano              Plano    @default(EQUIPE)
  antecedenciaMinMin Int      @default(120)
  /** Até quantas semanas à frente a cliente pode marcar pelo link público. */
  janelaAgendamentoSemanas Int @default(8)
  confirmacaoAutomatica Boolean @default(true)
  criadoEm           DateTime @default(now())
  assinanteDesde     DateTime?
  /** Conta parceira (piloto): usa sem cobrança e sem prazo de teste. Marcada no admin. */
  parceira           Boolean  @default(false)
  /** Fim do teste grátis quando o admin estende o prazo; nulo = 14 dias após o cadastro. */
  testeAte           DateTime?
  /** Conta criada só para testar o sistema: fica separada no admin e fora dos números. */
  contaDeTeste       Boolean  @default(false)
  /** Guia "Comece por aqui" (tela Hoje): passos marcados à mão ou ao salvar uma tela, ids
   * separados por vírgula. Os outros passos se completam sozinhos (ver src/lib/guia). */
  guiaPassos         String   @default("")
  /** Quando a dona escondeu o guia; nulo = o guia aparece na tela Hoje. */
  guiaEscondidoEm    DateTime?

  usuarios          Usuario[]
  profissionais     Profissional[]
  servicos          Servico[]
  categoriasServico CategoriaServico[]
  clientes          Cliente[]
  agendamentos      Agendamento[]
  lead              Lead?
}

model Usuario {
  id                String        @id @default(cuid())
  nome              String
  email             String        @unique
  senhaHash         String
  emailVerificadoEm DateTime?
  /** Último login no painel (o admin da Veylo mostra; a sessão some quando a pessoa sai). */
  ultimoLoginEm     DateTime?
  papel             PapelUsuario
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  profissionalId    String?       @unique
  profissional      Profissional? @relation(fields: [profissionalId], references: [id], onDelete: SetNull)
  criadoEm          DateTime      @default(now())
  sessoes           Sessao[]
  tokensVerificacao TokenVerificacao[]

  @@index([estabelecimentoId])
}

enum TipoTokenVerificacao {
  CONFIRMAR_EMAIL
  REDEFINIR_SENHA
}

model TokenVerificacao {
  id        String               @id @default(cuid())
  usuarioId String
  usuario   Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoTokenVerificacao
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime             @default(now())

  @@index([usuarioId])
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadaEm  DateTime @default(now())
  expiraEm  DateTime

  @@index([usuarioId])
}

model Profissional {
  id                 String   @id @default(cuid())
  nome               String
  foto               String?
  ativo              Boolean  @default(true)
  comissaoPercentual Int?
  estabelecimentoId  String
  estabelecimento    Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  usuario      Usuario?
  servicos     ServicoProfissional[]
  horarios     HorarioFuncionamento[]
  bloqueios    Bloqueio[]
  agendamentos Agendamento[]

  @@index([estabelecimentoId])
}

model Servico {
  id                String   @id @default(cuid())
  nome              String
  descricao         String
  duracaoMin        Int
  precoCentavos     Int
  cor               String
  foto              String?
  ativo             Boolean  @default(true)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  categoriaId       String?
  categoria         CategoriaServico? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  profissionais ServicoProfissional[]
  agendamentos  Agendamento[]

  @@index([estabelecimentoId])
  @@index([categoriaId])
}

/** Agrupa serviços na tela "Serviços" e no link público (ex: "Aplicação", "Manutenção",
 * "Gel", "Avulso") — opcional: um serviço sem categoria continua funcionando normalmente,
 * só aparece fora de qualquer grupo. `ordem` controla a sequência dos grupos (não é
 * alfabética — o dono decide, ex. Aplicação antes de Manutenção). */
model CategoriaServico {
  id                String   @id @default(cuid())
  nome              String
  ordem             Int      @default(0)
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  servicos Servico[]

  @@index([estabelecimentoId])
}

model ServicoProfissional {
  servicoId      String
  profissionalId String
  servico        Servico      @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@id([servicoId, profissionalId])
}

model HorarioFuncionamento {
  id             String  @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  diaSemana      Int
  abre           String
  fecha          String
  almocoInicio   String?
  almocoFim      String?
  fechado        Boolean @default(false)
  /** Quando preenchido ("11:00,13:00,14:30"), o dia funciona só nesses horários de início
   * em vez do intervalo abre/fecha com almoço — ex.: esmalteria que atende em horários fixos. */
  horariosFixos  String?

  @@unique([profissionalId, diaSemana])
}

model Bloqueio {
  id             String   @id @default(cuid())
  profissionalId String
  profissional   Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  inicio         DateTime
  fim            DateTime
  motivo         String

  @@index([profissionalId, inicio, fim])
}

model Cliente {
  id                String   @id @default(cuid())
  nome              String
  telefone          String
  email             String?
  observacoes       String?
  estabelecimentoId String
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  agendamentos      Agendamento[]
  mensagens         Mensagem[]
  criadoEm          DateTime @default(now())

  @@index([estabelecimentoId])
}

model Agendamento {
  id                String            @id @default(cuid())
  estabelecimentoId String
  estabelecimento   Estabelecimento   @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  clienteId         String
  cliente           Cliente           @relation(fields: [clienteId], references: [id])
  profissionalId    String
  profissional      Profissional      @relation(fields: [profissionalId], references: [id])
  servicoId         String
  servico           Servico           @relation(fields: [servicoId], references: [id])
  inicio            DateTime
  fim               DateTime
  status            StatusAgendamento @default(PENDENTE)
  origem            OrigemAgendamento
  observacao        String?
  tokenPublico      String            @unique @default(cuid())
  /** Preenchidos quando a própria cliente responde (botão no WhatsApp ou página do
   * agendamento) — usados pra avisar a dona no painel. */
  presencaConfirmadaEm   DateTime?
  canceladoPelaClienteEm DateTime?
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt

  mensagens Mensagem[]

  @@index([profissionalId, inicio])
  @@index([estabelecimentoId, inicio])
}

/** Linha única (id fixo) usada pelo botão "Simular passagem do tempo" da tela de Mensagens:
 * acumula um deslocamento aplicado ao instante atual só para fins de processamento da fila
 * de mensagens, sem afetar o motor de disponibilidade nem o restante do sistema. */
model RelogioSimulado {
  id           Int      @id @default(1)
  offsetMin    Int      @default(0)
  atualizadoEm DateTime @updatedAt
}

model Mensagem {
  id            String         @id @default(cuid())
  agendamentoId String?
  agendamento   Agendamento?   @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  clienteId     String?
  cliente       Cliente?       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo          TipoMensagem
  canal         CanalMensagem
  status        StatusMensagem @default(PENDENTE)
  texto         String
  variaveisTemplate String?
  agendadaPara  DateTime
  enviadaEm     DateTime?
  /** SID da mensagem na Twilio — é por ele que uma resposta da cliente (toque em
   * "Confirmar"/"Cancelar") é ligada de volta ao agendamento certo. */
  sidProvedor   String?

  @@index([status, agendadaPara])
  @@index([clienteId])
  @@index([sidProvedor])
}

/** Funil comercial do admin da Veylo: um salão que a equipe está tentando conquistar. Quando
 * ele cria a conta, o cadastro liga o contato ao estabelecimento e passa para "Em teste". */
model Lead {
  id                String    @id @default(cuid())
  nome              String
  contato           String    @default("")
  telefone          String    @default("")
  email             String    @default("")
  instagram         String    @default("")
  cidade            String    @default("")
  segmento          String    @default("")
  etapa             EtapaLead @default(PROSPECCAO)
  responsavel       String    @default("")
  proximoContatoEm  DateTime?
  anotacoes         String    @default("")
  estabelecimentoId String?   @unique
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id], onDelete: SetNull)
  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt

  @@index([etapa])
}

enum EtapaLead {
  PROSPECCAO
  CONTATO
  DEMONSTRACAO
  EM_TESTE
  FECHADO
  PERDIDO
}

/** Link de entrada no admin enviado por e-mail: uso único, vale 15 minutos. O id é o próprio
 * token do link (32 bytes aleatórios). */
model LinkAcessoAdmin {
  id       String    @id
  email    String
  criadoEm DateTime  @default(now())
  expiraEm DateTime
  usadoEm  DateTime?

  @@index([email])
}

/** Sessão do admin da Veylo, em cookie separado do painel dos salões. O id é o token do cookie. */
model SessaoAdmin {
  id       String   @id
  email    String
  criadaEm DateTime @default(now())
  expiraEm DateTime
}

/** Custo para manter a Veylo no ar (tela Financeiro do admin). Valores em dólar são convertidos
 * pela cotação do dia; POR_MENSAGEM multiplica pelas mensagens de WhatsApp dos últimos 30 dias. */
model Custo {
  id           String          @id @default(cuid())
  nome         String
  categoria    String          @default("")
  valor        Float
  moeda        MoedaCusto      @default(BRL)
  frequencia   FrequenciaCusto @default(MENSAL)
  observacao   String          @default("")
  ativo        Boolean         @default(true)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt
}

enum MoedaCusto {
  BRL
  USD
}

enum FrequenciaCusto {
  MENSAL
  ANUAL
  POR_MENSAGEM
}
